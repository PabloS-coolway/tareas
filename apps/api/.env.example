# Plantilla de configuración de la API.
# Copia este fichero a `.env` (mismo directorio) y ajusta los valores. El `.env` real NO se versiona.
#
#   cp apps/api/.env.example apps/api/.env

# --- Base de datos --------------------------------------------------------
# Postgres local vía Docker: `npm run db:up` desde la raíz (puerto host 5545, ver docker-compose.yml).
DATABASE_URL="postgresql://tareas:tareas@localhost:5545/tareas?schema=public"

# --- Autenticación (JWT) --------------------------------------------------
# En local, si no se define, la API usa un secreto de desarrollo. OBLIGATORIO al desplegar:
#   openssl rand -base64 32
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"

# --- API ------------------------------------------------------------------
PORT=3000

# --- Primer admin (idempotente; útil en despliegue, donde no hay CLI) -------
#ADMIN_EMAIL="pablo.silva@coolway.com"
#ADMIN_NAME="PabloS"
#ADMIN_PASSWORD="cambiar"

# --- Adjuntos · DigitalOcean Spaces (S3) ----------------------------------
# Si NO se definen, en desarrollo se usa disco local (carpeta uploads/, efímera) y en producción la
# subida queda deshabilitada (avisa, no pierde ficheros en silencio).
#SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
#SPACES_REGION="fra1"
#SPACES_BUCKET="yorga-tareas"
#SPACES_KEY="tu-access-key"
#SPACES_SECRET="tu-secret-key"

# --- Correo saliente (pantalla de admin «Correo») ---------------------------
# Clave maestra para cifrar la clave del proveedor guardada en la BD: 32 bytes en base64
# (`openssl rand -base64 32`). Sin ella no se puede guardar la configuración del proveedor.
#MAIL_ENCRYPTION_KEY=""
# URL pública de la app (enlaces de los correos).
#APP_URL="http://localhost:5173"
# Compatibilidad: si NO hay nada guardado en el panel, se usa este SMTP.
#SMTP_URL="smtps://usuario:clave@smtp.ejemplo.com:465"
#MAIL_FROM="Tareas <tareas@ejemplo.com>"
# Cada cuánto trabaja la cola de correo (ms; por defecto 30 s).
#CORREO_CADA_MS=30000
