generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Acceso ----------

model Role {
  id        Int      @id @default(autoincrement())
  /// Clave estable e identidad del rol: miembro, admin…
  key       String   @unique
  name      String
  /// Features que tiene el rol (subconjunto del catálogo cerrado de @yorga/contracts).
  features  String[]
  active    Boolean  @default(true)
  /// Roles de sistema (miembro/admin): no se borran ni se les cambia la clave.
  system    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("role")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  /// Clave del rol (FK a role.key).
  role         String   @default("miembro")
  roleRef      Role     @relation(fields: [role], references: [key])
  active       Boolean  @default(true)
  /// Id del miembro en ClickUp (para mapear asignados al importar).
  clickupId    String?  @unique @map("clickup_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  apiTokens     ApiToken[]
  tasksAssigned Task[]         @relation("assignee")
  tasksReported Task[]         @relation("reporter")
  comments      TaskComment[]
  attachments   Attachment[]
  activities    TaskActivity[]

  @@map("app_user")
}

/// Token personal para la API (Claude/MCP, scripts). Se guarda el hash, nunca el token.
model ApiToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique @map("token_hash")
  prefix     String
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("api_token")
}

// ---------- Proyectos y tareas ----------

enum StatusCategory {
  TODO
  DOING
  DONE
}

enum TaskType {
  EPIC
  TASK
  BUG
  INCIDENT
}

enum Priority {
  URGENT
  HIGH
  NORMAL
  LOW
}

model Project {
  id            Int      @id @default(autoincrement())
  /// Prefijo de las claves de tarea (COOL → COOL-12).
  key           String   @unique
  name          String
  description   String   @default("")
  color         String   @default("#6d28d9")
  archived      Boolean  @default(false)
  /// Siguiente número de tarea (COOL-<n>). Se incrementa en la misma transacción que crea la tarea.
  nextNumber    Int      @default(1) @map("next_number")
  clickupListId String?  @unique @map("clickup_list_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  statuses ProjectStatus[]
  tasks    Task[]

  @@map("project")
}

/// Estados configurables por proyecto (columnas del tablero).
model ProjectStatus {
  id        Int            @id @default(autoincrement())
  projectId Int            @map("project_id")
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  name      String
  color     String         @default("#6b7280")
  order     Int            @default(0)
  category  StatusCategory @default(TODO)

  tasks Task[]

  @@unique([projectId, key])
  @@map("project_status")
}

model Task {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Número dentro del proyecto: COOL-<number>.
  number      Int
  title       String
  description String    @default("")
  type        TaskType  @default(TASK)
  statusId    Int       @map("status_id")
  status      ProjectStatus @relation(fields: [statusId], references: [id])
  priority    Priority  @default(NORMAL)
  assigneeId  Int?      @map("assignee_id")
  assignee    User?     @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId  Int       @map("reporter_id")
  reporter    User      @relation("reporter", fields: [reporterId], references: [id])
  /// Padre: una épica (agrupa) o una tarea (entonces esto es una subtarea).
  parentId    Int?      @map("parent_id")
  parent      Task?     @relation("subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks    Task[]    @relation("subtasks")
  dueDate     DateTime? @map("due_date") @db.Date
  startDate   DateTime? @map("start_date") @db.Date
  tags        String[]
  /// Posición dentro de su columna del tablero.
  order       Float     @default(0)
  closedAt    DateTime? @map("closed_at")
  clickupId   String?   @unique @map("clickup_id")
  clickupUrl  String?   @map("clickup_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  comments    TaskComment[]
  attachments Attachment[]
  activities  TaskActivity[]

  @@unique([projectId, number])
  @@index([projectId, statusId, order])
  @@index([assigneeId])
  @@index([parentId])
  @@map("task")
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  Int      @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  clickupId String?  @unique @map("clickup_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId, createdAt])
  @@map("task_comment")
}

model Attachment {
  id         Int      @id @default(autoincrement())
  taskId     Int      @map("task_id")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId Int      @map("uploader_id")
  uploader   User     @relation(fields: [uploaderId], references: [id])
  filename   String
  mimeType   String   @map("mime_type")
  size       Int
  /// Clave en el almacenamiento (disco local o Spaces).
  storageKey String   @unique @map("storage_key")
  clickupUrl String?  @map("clickup_url")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("attachment")
}

/// Historial de cambios de una tarea (quién cambió qué).
model TaskActivity {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   Int?     @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  field     String?
  before    String?
  after     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("task_activity")
}
