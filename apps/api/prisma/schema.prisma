generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Acceso ----------

model Role {
  id        Int      @id @default(autoincrement())
  /// Clave estable e identidad del rol: miembro, admin…
  key       String   @unique
  name      String
  /// Features que tiene el rol (subconjunto del catálogo cerrado de @yorga/contracts).
  features  String[]
  active    Boolean  @default(true)
  /// Roles de sistema (miembro/admin): no se borran ni se les cambia la clave.
  system    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("role")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  /// Clave del rol (FK a role.key).
  role         String   @default("miembro")
  roleRef      Role     @relation(fields: [role], references: [key])
  active       Boolean  @default(true)
  /// Id del miembro en ClickUp (para mapear asignados al importar).
  clickupId    String?  @unique @map("clickup_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  apiTokens     ApiToken[]
  tasksAssigned Task[]         @relation("assignee")
  tasksReported Task[]         @relation("reporter")
  tasksFollowed TaskFollower[]
  rulesCreated  AutomationRule[]
  comments      TaskComment[]
  attachments   Attachment[]
  activities    TaskActivity[]
  notifications Notification[]    @relation("notified")
  savedViews    SavedView[]
  passwordResets PasswordReset[]
  teams         TeamMember[]

  @@map("app_user")
}

// ---------- Equipos ----------

/// Equipo (área: Tecnología, Marketing…): agrupa proyectos y personas y decide quién ve qué.
/// Un proyecto sin equipo lo ve todo el mundo.
model Team {
  id        Int      @id @default(autoincrement())
  /// Clave corta y estable: TECH, MKT…
  key       String   @unique
  name      String
  color     String   @default("#4338ca")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]
  members  TeamMember[]
  sprints  Sprint[]

  @@map("team")
}

model TeamMember {
  teamId    Int      @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_member")
}

/// Token personal para la API (Claude/MCP, scripts). Se guarda el hash, nunca el token.
model ApiToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique @map("token_hash")
  prefix     String
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  logs ApiTokenLog[]

  @@map("api_token")
}

/// Registro de uso de un token de API: llamadas a herramientas MCP y peticiones directas a la API.
model ApiTokenLog {
  id        Int      @id @default(autoincrement())
  tokenId   Int      @map("token_id")
  token     ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  /// `mcp` (herramienta por el endpoint remoto) o `api` (petición HTTP con el token).
  source    String
  /// Nombre de la herramienta o `GET /tasks`.
  action    String
  /// Argumentos (recortados) o ruta completa.
  detail    String?
  ok        Boolean  @default(true)
  ms        Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tokenId, createdAt])
  @@index([createdAt])
  @@map("api_token_log")
}

// ---------- Proyectos y tareas ----------

enum StatusCategory {
  TODO
  DOING
  DONE
}

enum TaskType {
  EPIC
  TASK
  BUG
  INCIDENT
}

enum Priority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum NotificationType {
  MENTION
  ASSIGNED
  COMMENT
  STATUS
  BLOCKER_DONE
  PASSWORD_RESET
  FOLLOW
  RULE
}

/// Sprint de trabajo. Ámbito: de un **proyecto** (`projectId`: sólo sus tareas), de un **equipo**
/// (`teamId`: tareas de los proyectos del equipo) o **global** (ninguno: cualquier proyecto).
model Sprint {
  id        Int          @id @default(autoincrement())
  name      String
  goal      String       @default("")
  projectId Int?         @map("project_id")
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId    Int?         @map("team_id")
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  startDate DateTime?    @map("start_date") @db.Date
  endDate   DateTime?    @map("end_date") @db.Date
  status    SprintStatus @default(PLANNED)
  closedAt  DateTime?    @map("closed_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tasks Task[]

  @@index([projectId])
  @@index([teamId])
  @@map("sprint")
}

model Project {
  id            Int      @id @default(autoincrement())
  /// Prefijo de las claves de tarea (COOL → COOL-12).
  key           String   @unique
  name          String
  description   String   @default("")
  color         String   @default("#6d28d9")
  archived      Boolean  @default(false)
  /// Siguiente número de tarea (COOL-<n>). Se incrementa en la misma transacción que crea la tarea.
  nextNumber    Int      @default(1) @map("next_number")
  clickupListId String?  @unique @map("clickup_list_id")
  /// Equipo dueño del proyecto; null = lo ve todo el mundo.
  teamId        Int?     @map("team_id")
  team          Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  statuses ProjectStatus[]
  tasks    Task[]
  sprints  Sprint[]

  @@index([teamId])
  rules       AutomationRule[]

  @@map("project")
}

/// Estados configurables por proyecto (columnas del tablero).
model ProjectStatus {
  id        Int            @id @default(autoincrement())
  projectId Int            @map("project_id")
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  name      String
  color     String         @default("#6b7280")
  order     Int            @default(0)
  category  StatusCategory @default(TODO)
  /// Límite de trabajo en curso (WIP) de la columna; null = sin límite. Sólo avisa, no bloquea.
  wipLimit  Int?           @map("wip_limit")

  tasks Task[]

  @@unique([projectId, key])
  @@map("project_status")
}

model Task {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Número dentro del proyecto: COOL-<number>.
  number      Int
  title       String
  description String    @default("")
  type        TaskType  @default(TASK)
  statusId    Int       @map("status_id")
  status      ProjectStatus @relation(fields: [statusId], references: [id])
  priority    Priority  @default(NORMAL)
  assigneeId  Int?      @map("assignee_id")
  assignee    User?     @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId  Int       @map("reporter_id")
  reporter    User      @relation("reporter", fields: [reporterId], references: [id])
  /// Padre: una épica (agrupa) o una tarea (entonces esto es una subtarea).
  parentId    Int?      @map("parent_id")
  parent      Task?     @relation("subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks    Task[]    @relation("subtasks")
  /// Sprint al que está planificada (o ninguno = backlog).
  sprintId    Int?      @map("sprint_id")
  sprint      Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  dueDate     DateTime? @map("due_date") @db.Date
  startDate   DateTime? @map("start_date") @db.Date
  tags        String[]
  /// Estimación en puntos (story points); null = sin estimar.
  estimate    Int?
  /// Repetición: al terminarla se crea la siguiente ocurrencia con la fecha desplazada.
  recurrence  Recurrence @default(NONE)
  /// Posición dentro de su columna del tablero.
  order       Float     @default(0)
  closedAt    DateTime? @map("closed_at")
  clickupId   String?   @unique @map("clickup_id")
  clickupUrl  String?   @map("clickup_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  comments      TaskComment[]
  attachments   Attachment[]
  activities    TaskActivity[]
  /// Dependencias: esta tarea está bloqueada por… / bloquea a…
  blockedBy     TaskDependency[] @relation("blocked")
  blocks        TaskDependency[] @relation("blocker")
  notifications Notification[]
  /// Personas de seguimiento: reciben los mismos avisos que el responsable.
  followers     TaskFollower[]

  @@unique([projectId, number])
  @@index([projectId, statusId, order])
  @@index([assigneeId])
  @@index([parentId])
  @@index([sprintId])
  @@map("task")
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  Int      @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  clickupId String?  @unique @map("clickup_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([taskId, createdAt])
  @@map("task_comment")
}

model Attachment {
  id         Int      @id @default(autoincrement())
  taskId     Int      @map("task_id")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId Int      @map("uploader_id")
  uploader   User     @relation(fields: [uploaderId], references: [id])
  filename   String
  mimeType   String   @map("mime_type")
  size       Int
  /// Clave en el almacenamiento (disco local o Spaces).
  storageKey String   @unique @map("storage_key")
  clickupUrl String?  @map("clickup_url")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("attachment")
}

/// Historial de cambios de una tarea (quién cambió qué).
model TaskActivity {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   Int?     @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  field     String?
  before    String?
  after     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("task_activity")
}

/// Seguidor de una tarea (persona de seguimiento, además del responsable): recibe sus avisos.
model TaskFollower {
  taskId    Int      @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_follower")
}

/// "blocked" no puede empezar/terminar hasta que "blocker" esté hecha.
model TaskDependency {
  id        Int      @id @default(autoincrement())
  blockerId Int      @map("blocker_id")
  blocker   Task     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId Int      @map("blocked_id")
  blocked   Task     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("task_dependency")
}

/// Aviso en la app para una persona (mención, asignación, comentario, cambio de estado…).
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  user      User             @relation("notified", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  taskId    Int?             @map("task_id")
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   Int?             @map("actor_id")
  text      String
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

/// Filtros guardados con nombre (por persona; `shared` = los ven todos).
model SavedView {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `project` (con projectId) o `global`.
  scope     String
  projectId Int?     @map("project_id")
  name      String
  filters   Json
  shared    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, scope, projectId])
  @@map("saved_view")
}

/// Plantilla de tarea: campos + títulos de subtareas. Sin projectId = válida para cualquier proyecto.
model TaskTemplate {
  id          Int      @id @default(autoincrement())
  projectId   Int?     @map("project_id")
  name        String
  title       String
  description String   @default("")
  type        TaskType @default(TASK)
  priority    Priority @default(NORMAL)
  tags        String[]
  estimate    Int?
  /// Títulos de las subtareas que se crean con ella.
  subtasks    String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("task_template")
}

/// Token de "he olvidado mi contraseña": se guarda el hash, caduca en 1 h y se usa una sola vez.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset")
}

/// Regla automática de un proyecto: cuando pasa X (y se cumplen las condiciones) → acciones.
model AutomationRule {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  active      Boolean  @default(true)
  /// CREATED | STATUS (ver RULE_TRIGGERS en contracts).
  trigger     String
  /// RuleConditionsDto / RuleActionsDto (catálogo cerrado, validado en el servicio).
  conditions  Json     @default("{}")
  actions     Json     @default("{}")
  createdById Int?     @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs        Int      @default(0)
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId, active])
  @@map("automation_rule")
}
